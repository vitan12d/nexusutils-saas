rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Catch-all Safety Net: Deny Everything By Default
    match /{document=**} {
      allow read, write: if false;
    }

    // Global Helpers & Primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // ==========================================
    // 2. User Profiles Collection Guidelines
    // ==========================================
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) 
        && isValidId(userId)
        && isValidUser(incoming());
      allow update: if isOwner(userId) 
        && isValidId(userId)
        && isValidUser(incoming())
        && incoming().uid == existing().uid
        && incoming().email == existing().email
        && incoming().createdAt == existing().createdAt
        && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'premiumTier']);
      allow delete: if false; // System policy forbids client profiles removals
    }

    function isValidUser(data) {
      return data.uid is string && data.uid.size() <= 128
        && data.email is string && data.email.size() <= 128
        && (!data.keys().hasAll(['displayName']) || (data.displayName is string && data.displayName.size() <= 128))
        && (!data.keys().hasAll(['photoURL']) || (data.photoURL is string && data.photoURL.size() <= 512))
        && data.createdAt is timestamp && data.createdAt == request.time
        && (!data.keys().hasAll(['premiumTier']) || data.premiumTier is bool);
    }

    // ==========================================
    // 3. User Feedback Collection Guidelines
    // ==========================================
    match /feedback/{feedbackId} {
      allow create: if isValidId(feedbackId)
        && isValidFeedback(incoming());
      allow get, list: if isAdmin();
      allow update, delete: if false; // Submissions are strictly immutable write-once logs
    }

    function isValidFeedback(data) {
      return data.type is string && (data.type == 'suggestion' || data.type == 'issue' || data.type == 'feedback')
        && data.message is string && data.message.size() > 0 && data.message.size() <= 10000
        && (!data.keys().hasAll(['subject']) || (data.subject is string && data.subject.size() <= 200))
        && data.createdAt is timestamp && data.createdAt == request.time
        && (!data.keys().hasAll(['userId']) || (data.userId == null || (data.userId is string && data.userId == request.auth.uid)))
        && (!data.keys().hasAll(['userEmail']) || (data.userEmail is string && data.userEmail.size() <= 128));
    }
  }
}
